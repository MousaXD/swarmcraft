[Unit]
Description=SwarmCraft authenticated storage and voting replica
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=swarmcraft
Group=swarmcraft
StateDirectory=swarmcraft-replica
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/swarmcraft --data-dir /var/lib/swarmcraft-replica daemon --replica-only --listen /ip4/0.0.0.0/udp/41000/quic-v1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
